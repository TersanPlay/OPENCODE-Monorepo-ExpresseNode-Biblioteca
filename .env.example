# Copie para apps/api/.env (desenvolvimento) e ajuste os valores.
# Nunca commite arquivos .env reais.

DATABASE_URL="file:./dev.db"
JWT_SECRET=troque-por-um-segredo-forte-de-no-minimo-32-caracteres
JWT_EXPIRES=8h
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@biblioteca.local
ADMIN_PASSWORD=troque-por-uma-senha-forte
CORS_ORIGIN=http://localhost:5173
PORT=3333

# E-mail via Zoho Mail SMTP (recuperação de senha). Conta pessoal @zohomail.com:
# https://www.zoho.com/pt-br/mail/help/zoho-smtp.html
# Com 2FA ativado, use senha de aplicativo em vez da senha normal.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
ZOHO_EMAIL=
ZOHO_APP_PASSWORD=
# Remetente (padrão: igual a ZOHO_EMAIL — o Zoho exige que corresponda à conta):
# MAIL_FROM=
# URL pública do frontend usada no link de redefinição:
FRONTEND_URL=http://localhost:5173

# ISBNdb (atualização cadastral do acervo). A chave fica só no backend.
# No Worker: `wrangler secret put ISBNDB_API_KEY --name biblioteca-api`
ISBNDB_API_KEY=
# Intervalo entre chamadas à ISBNdb (ms). Padrão: 1100 (plano Basic: 1 req/s)
ISBNDB_DELAY_MS=1100
# ISBNs por requisição no endpoint bulk. Basic: 100; Academic: 10; Pro+: 1000.
# Se vazio, o plano é detectado via GET /key.
ISBNDB_BULK_SIZE=100

# Frontend (apps/web/.env, opcional — o padrão usa o proxy do Vite):
# VITE_API_URL=http://localhost:3333/api
